{% comment %}
  KWADZILLA — coming soon

  A volumetric fire filling the viewport, raymarched in the browser —
  there is no image and no video to load.

  It reacts: on a pointer the flames lean towards the cursor and flare
  under it, on a touchscreen a drag does the same and a tap throws a
  burst, and the phone's own tilt pushes the whole front sideways.

  Drop this on the password template for a coming-soon page, or on any
  page template. Nothing here depends on the rest of the theme, so it can
  be lifted into another one as-is.

  WORDMARK
  Paste an SVG into the Wordmark SVG setting and it replaces the two text
  lines entirely — no other change needed. Leave it empty and the text is
  used, in the custom font if one is set: upload the .woff2 to assets/ and
  name it in the Typeface setting.
{% endcomment %}

{{ 'kwadzilla-splash.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign vh = '100svh'
  case section.settings.height
    when 'large'
      assign vh = '82svh'
    when 'medium'
      assign vh = '64svh'
  endcase
-%}

{%- if section.settings.font_woff2 != blank -%}
  {% style %}
    @font-face {
      font-family: "Kwadzilla Display";
      src: url({{ section.settings.font_woff2 | asset_url }}) format("woff2");
      font-weight: {{ section.settings.font_weight }};
      font-style: normal;
      font-display: swap;
    }
  {% endstyle %}
{%- endif -%}

{% style %}
  #kwad-soon-{{ section.id }} {
    min-height: {{ vh }};
    --kwad-paper: {{ section.settings.color_paper }};
    --kwad-ink: {{ section.settings.color_ink }};
    --kwad-ink-soft: {{ section.settings.color_ink | color_mix: section.settings.color_paper, 55 }};
    {%- if section.settings.font_woff2 != blank %}
    --kwad-font-display: "Kwadzilla Display", {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    {%- else %}
    --kwad-font-display: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    {%- endif %}
  }
{% endstyle %}

<div
  id="kwad-soon-{{ section.id }}"
  class="kwad-soon"
  data-kwadzilla-soon
>
  {% comment %}
    Shown until the canvas takes over, and for good if it never does, so a
    visitor without WebGL gets a lit surface rather than a flat panel.
  {% endcomment %}
  <div class="kwad-soon__floor" aria-hidden="true"></div>

  <div class="kwad-soon__words">
    {% comment %}
      An SVG here wins: the script sees it, adds .has-mark, and the text
      lines below take themselves out.
    {% endcomment %}
    <div class="kwad-soon__mark" data-kwad-mark>{{ section.settings.wordmark_svg }}</div>

    {%- if section.settings.heading != blank -%}
      <h1 class="kwad-soon__word" data-kwad-split>{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="kwad-soon__sub" data-kwad-split>{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  {%- if section.settings.note != blank -%}
    <p class="kwad-soon__note">{{ section.settings.note }}</p>
  {%- endif -%}

  {% comment %}
    iOS will not hand out motion data without a gesture, so on those
    devices — and only those — the script reveals this button. It hides
    itself again after the first tilt.
  {% endcomment %}
  <button class="kwad-soon__tilt" type="button" data-kwad-tilt>
    {{ section.settings.tilt_label }}
  </button>
</div>

<script src="{{ 'kwadzilla-splash.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Kwadzilla coming soon",
  "tag": "section",
  "class": "kwadzilla-coming-soon",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "2072"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Soundboy Kwad"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Footnote",
      "default": "Coming soon"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "full",
      "info": "Use Large on the password page so the Enter using password link stays in view."
    },
    {
      "type": "header",
      "content": "Wordmark"
    },
    {
      "type": "html",
      "id": "wordmark_svg",
      "label": "Wordmark SVG",
      "info": "Paste an <svg> here and it replaces the heading and subheading. Needs a viewBox to scale; use fill=\"currentColor\" to take the text colour."
    },
    {
      "type": "header",
      "content": "Typeface"
    },
    {
      "type": "text",
      "id": "font_woff2",
      "label": "Wordmark font file",
      "info": "Filename of a .woff2 uploaded to assets, e.g. kwadzilla-display.woff2. Leave empty to use the theme font."
    },
    {
      "type": "text",
      "id": "font_weight",
      "label": "Font weight",
      "default": "400",
      "info": "A single weight (400) or a variable range (400 700)."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "color_paper",
      "label": "Page colour",
      "default": "#080503",
      "info": "Shown before the canvas loads, and if WebGL is unavailable."
    },
    {
      "type": "color",
      "id": "color_ink",
      "label": "Text",
      "default": "#fff3e4"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "text",
      "id": "tilt_label",
      "label": "Tilt permission prompt",
      "default": "Tap to let it follow you",
      "info": "Shown only on iOS, which requires a tap before a page may read device motion (used here for the tilt-driven wind)."
    }
  ],
  "presets": [
    {
      "name": "Kwadzilla coming soon"
    }
  ]
}
{% endschema %}
